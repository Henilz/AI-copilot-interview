# Database
DATABASE_URL=postgresql+asyncpg://user:password@localhost:5432/interview_copilot
SYNC_DATABASE_URL=postgresql+psycopg2://user:password@localhost:5432/interview_copilot

# Redis
REDIS_URL=redis://localhost:6379/0

# OpenAI
OPENAI_API_KEY=sk-...
# Optional for OpenAI-compatible providers such as NVIDIA NIM.
# NVIDIA example:
# OPENAI_API_KEY=nvapi-...
# OPENAI_BASE_URL=https://integrate.api.nvidia.com/v1
# RESUME_PARSE_MODEL=openai/gpt-oss-20b
# QUESTION_GENERATION_MODEL=openai/gpt-oss-20b
# SUGGESTION_MODEL=openai/gpt-oss-20b
# TRANSCRIPT_SUMMARY_MODEL=openai/gpt-oss-20b
# EVALUATION_MODEL=openai/gpt-oss-120b
OPENAI_BASE_URL=
RESUME_PARSE_MODEL=gpt-4o-mini
QUESTION_GENERATION_MODEL=gpt-4o-mini
SUGGESTION_MODEL=gpt-4o-mini
TRANSCRIPT_SUMMARY_MODEL=gpt-4o-mini
EVALUATION_MODEL=gpt-4o

# Speech-to-text via Groq Whisper (used when "Listen to Answer" is clicked).
# Get a key from https://console.groq.com/keys
GROQ_API_KEY=gsk_...
GROQ_WHISPER_MODEL=whisper-large-v3-turbo

# JWT
SECRET_KEY=change-me-in-production-use-openssl-rand-hex-32
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Interviewer credentials
INTERVIEWER_USERNAME=interviewer
INTERVIEWER_PASSWORD=your-strong-password-here

# AWS S3 (for PDF storage). Leave AWS_ACCESS_KEY_ID and AWS_SECRET_ACCESS_KEY
# empty to use the local-disk fallback served at /api/evaluations/files/{key}.
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_BUCKET_NAME=interview-copilot-reports
AWS_REGION=us-east-1

# Local fallback (used when AWS keys are empty). API_PUBLIC_URL is the base the
# frontend can reach the API at — embedded in the returned PDF URL.
LOCAL_REPORTS_DIR=/app/data/reports
API_PUBLIC_URL=http://localhost:8000

# File upload limits
MAX_FILE_SIZE_MB=5

# Celery
CELERY_BROKER_URL=redis://localhost:6379/1
CELERY_RESULT_BACKEND=redis://localhost:6379/2
