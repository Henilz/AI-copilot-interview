# Database
DATABASE_URL=postgresql+asyncpg://user:password@localhost:5432/interview_copilot
SYNC_DATABASE_URL=postgresql+psycopg2://user:password@localhost:5432/interview_copilot

# Redis
REDIS_URL=redis://localhost:6379/0

# OpenAI
OPENAI_API_KEY=sk-...

# JWT
SECRET_KEY=change-me-in-production-use-openssl-rand-hex-32
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Interviewer credentials
INTERVIEWER_USERNAME=interviewer
INTERVIEWER_PASSWORD=your-strong-password-here

# AWS S3 (for PDF storage)
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_BUCKET_NAME=interview-copilot-reports
AWS_REGION=us-east-1

# File upload limits
MAX_FILE_SIZE_MB=5

# Celery
CELERY_BROKER_URL=redis://localhost:6379/1
CELERY_RESULT_BACKEND=redis://localhost:6379/2
